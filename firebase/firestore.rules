rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    // Pengguna yang berhasil login (Firebase Authentication) dianggap admin yang sah
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated();
    }

    // ── Koleksi Publik (Bisa dibaca siapa saja untuk Display TV) ──
    // Display TV hanya membaca (get, list) data publik secara realtime tanpa login.
    // Menulis/mengubah/menghapus HANYA diperbolehkan untuk Admin yang telah login.

    // 1. Pengaturan Identitas Masjid & Tampilan
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Koreksi / Jadwal Salat Manual
    match /prayerSchedules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Jadwal Kajian
    match /kajian/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Agenda & Kegiatan Masjid
    match /activities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Berita & Informasi Masjid
    match /news/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Pengumuman Berjalan / Running Text & Banner
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Jadwal Petugas Salat Jumat (Khatib, Imam, Muazin)
    match /fridaySchedules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Laporan Keuangan & ZISWAF
    match /financeReports/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Kode & Informasi QRIS Infaq / Sedekah
    match /qris/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Pengaturan Slide Display TV
    match /displaySlides/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Konten Kustom Slide Display TV (Ayat / Hadits / Doa)
    match /slideContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Koleksi Profil Admin ──
    match /adminProfiles/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny untuk path lainnya
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
