rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Izinkan Display TV dan Admin membaca serta menulis data
    // Agar perubahan dari HP atau Laptop langsung tersinkron ke Layar TV secara realtime
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
