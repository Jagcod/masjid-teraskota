rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Cek apakah user sudah login
    function isAuthenticated() {
      return request.auth != null;
    }

    // Semua gambar atau media di storage
    match /{allPaths=**} {
      // Siapapun bisa melihat gambar pada Display TV
      allow read: if true;
      // Admin yang telah login diizinkan mengunggah dan menghapus media
      allow write: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
